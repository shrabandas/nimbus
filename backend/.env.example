# Copy this file to .env locally (never commit .env itself).
# On Render: Dashboard -> your service -> Environment -> add these as real env vars.

# Admin login credentials (do not use the old demo defaults)
ADMIN_EMAIL=youradmin@example.com
ADMIN_PASSWORD=choose-a-strong-password-here

# Turso (libSQL) database connection
# Get these from https://turso.tech dashboard -> your database -> "Connect"
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here
